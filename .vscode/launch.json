{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ParticleSimulator (gdb) - Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/ParticleSimulator.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "internalConsoleOptions": "openOnSessionStart",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
      "avoidWindowsConsoleRedirection": true,
      "logging": {
        "engineLogging": true,
        "trace": true,
        "programOutput": true,
        "exceptions": true
      },
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "text": "catch throw",
          "ignoreFailures": true
        },
        {
          "text": "catch catch",
          "ignoreFailures": true
        },
        {
          "text": "break abort",
          "ignoreFailures": true
        },
        {
          "text": "break std::terminate",
          "ignoreFailures": true
        },
        {
          "text": "handle SIGTERM stop print nopass",
          "ignoreFailures": true
        },
        {
          "text": "handle SIGINT  stop print nopass",
          "ignoreFailures": true
        },
        {
          "text": "handle SIGSEGV stop print nopass",
          "ignoreFailures": true
        }
      ]
    },
